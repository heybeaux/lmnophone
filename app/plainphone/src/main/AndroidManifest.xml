<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The 15-minute re-apply is an exact alarm (ReapplyAlarm). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />


    <!-- Lets the home screen open the listed apps (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      preview-2 (PLA-144): Device Owner and Home. testOnly so `dpm remove-active-admin` stays the way out
      until Q7 is proven on the spare.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <application
        android:name=".PlainphoneApp"
        android:allowBackup="false"
        android:testOnly="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Home. if_whitelisted starts lock task as the task launches, before its first frame. -->
        <activity
            android:name=".MainActivity"
            android:directBootAware="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Direct Boot aware: the locked-boot re-apply runs before the first unlock. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".boot.ReapplyAlarm"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".boot.FlushMarker"
            android:enabled="false"
            android:exported="false" />

        <!-- Setup script commands. DUMP: only the adb shell can send these. -->
        <receiver
            android:name=".preview.SetupCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.plainphone.preview.SET_STARTER" />
                <action android:name="org.plainphone.preview.APPLY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PlainphoneAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the home screen open the listed apps (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      preview-2 (PLA-144): Device Owner and Home. testOnly so `dpm remove-active-admin` stays the way out
      until Q7 is proven on the spare.
    -->
    <application
        android:allowBackup="false"
        android:testOnly="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Flipped after every unhide (mitigation B); never receives anything. -->
        <receiver
            android:name=".preview.FlushMarker"
            android:exported="false" />

        <!-- Setup script commands. DUMP: only the adb shell can send these. -->
        <receiver
            android:name=".preview.SetupCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.plainphone.preview.SET_STARTER" />
                <action android:name="org.plainphone.preview.APPLY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PlainphoneAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

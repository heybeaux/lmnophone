<!-- Test build: testOnly, so `dpm remove-active-admin` can remove the Device Owner (TEAM-POLICY gate 2). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:testOnly="true">
        <!-- Scenario set-up for adb (TestHook). Shell holds DUMP; apps do not. -->
        <receiver
            android:name=".boot.TestHook"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.plainphone.test.RELAX" />
                <action android:name="org.plainphone.test.DROP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

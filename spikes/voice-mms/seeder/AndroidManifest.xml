<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright 2026 LMNOPhone contributors. SPDX-License-Identifier: Apache-2.0. THROWAWAY (PLA-458).
     Has just enough components to be eligible for the SMS role on the emulator, so it can write one test
     "incoming" voice MMS into content://mms. The role goes straight back to Google Messages afterwards. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.plainphone.spike458.seeder">
  <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.READ_SMS"/>
  <application android:label="PLA-458 MMS seeder" android:debuggable="true" android:testOnly="true">
    <activity android:name="org.plainphone.spike458.Seeder" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/></intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SENDTO"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:scheme="sms"/><data android:scheme="smsto"/><data android:scheme="mms"/><data android:scheme="mmsto"/>
      </intent-filter>
    </activity>
    <receiver android:name="org.plainphone.spike458.Noop" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
      <intent-filter><action android:name="android.provider.Telephony.SMS_DELIVER"/></intent-filter>
    </receiver>
    <receiver android:name="org.plainphone.spike458.NoopWap" android:exported="true" android:permission="android.permission.BROADCAST_WAP_PUSH">
      <intent-filter>
        <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER"/>
        <data android:mimeType="application/vnd.wap.mms-message"/>
      </intent-filter>
    </receiver>
    <service android:name="org.plainphone.spike458.NoopService" android:exported="true" android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
      <intent-filter>
        <action android:name="android.intent.action.RESPOND_VIA_MESSAGE"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:scheme="sms"/><data android:scheme="smsto"/><data android:scheme="mms"/><data android:scheme="mmsto"/>
      </intent-filter>
    </service>
  </application>
</manifest>
